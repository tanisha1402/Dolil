# ---- Server ----
PORT=8787
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- Google AI Studio (hosted Gemma). Server only - never expose to the client or commit. ----
# Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Documented Gemma 4 IDs on the Gemini API: gemma-4-31b-it (higher quality), gemma-4-26b-a4b-it (faster/cheaper)
GOOGLE_MODEL=gemma-4-31b-it
GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_MS=60000

# ---- Document processing limits ----
MAX_UPLOAD_MB=8
MAX_TEXT_CHARS=20000
MAX_PDF_PAGES=30
RATE_LIMIT_MAX=30
RATE_LIMIT_AI_MAX=40
# Reverse proxies in front of the server (hosts like Render = 1). Defaults to 1 when NODE_ENV=production.
# TRUST_PROXY=1
